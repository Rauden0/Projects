<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_tracked_marker" />

        <TextView
            android:id="@+id/sheetPersonName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Jana Kováčová" />

    </LinearLayout>

    <TextView
        android:id="@+id/sheetLastSeenLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/last_seen_label"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sheetLastSeenValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        tools:text="5 minutes ago" />

    <TextView
        android:id="@+id/sheetLocationLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/location_label"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sheetLocationValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/on_surface"
        android:textSize="16sp"
        tools:text="Veveří, Brno-střed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetStopTrackingButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/surface"
        android:text="@string/stop_tracking"
        android:textAllCaps="false"
        android:textColor="@color/brand_primary"
        app:cornerRadius="24dp"
        app:strokeColor="@color/brand_primary"
        app:strokeWidth="1dp" />

</LinearLayout>

# Copy to keystore.properties (gitignored) after generating the upload keystore.
# Generate once (from the Android project root):
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias upload -storepass <STORE_PASS> -keypass <KEY_PASS> \
#     -dname "CN=BubuTracker, OU=Mobile, O=Martin Mucka, L=City, ST=State, C=SK"
#
# Back up upload-keystore.jks offline. Losing it blocks updates if you leave Play App Signing.

storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD

# Copy to secrets.properties (gitignored) and fill real production values.
# Debug builds fall back to the defaults below if a key is missing.
# Release builds fail if any required key is still a placeholder.

# Auth0 (Native Android app)
auth0Domain=YOUR_TENANT.auth0.com
auth0ClientId=YOUR_AUTH0_CLIENT_ID
auth0Audience=https://api.bubutracker
auth0Scheme=bubutracker

# Backend (trailing slash required)
# Local test with ngrok: run `bash play/dev-ngrok.sh` — it overwrites both URLs.
# Emulator without tunnel: http://10.0.2.2:8080/
# Production later: https://api.yourdomain.com/
apiBaseUrlDebug=http://10.0.2.2:8080/
apiBaseUrlRelease=https://api.bubutracker.example.com/

# The map screen renders OpenStreetMap tiles via osmdroid - no API key needed.

# Public HTTPS URL for the privacy policy (shown as an in-app link on login + profile).
# Host play/privacy/index.html and paste that URL here.
privacyPolicyUrl=https://YOUR_DOMAIN/bubutracker/privacy

# Copy to .env for local development (docker-compose reads this file automatically).

APP_ENV=development
HTTP_PORT=8080

# postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL=postgres://bubutracker:bubutracker@localhost:5432/bubutracker?sslmode=disable

# Read by deploy/docker-compose.yml to configure the postgres container itself
# and to build that same DATABASE_URL for the migrate/api services - keep the
# credentials here in sync with the DATABASE_URL above if you change them.
POSTGRES_USER=bubutracker
POSTGRES_PASSWORD=bubutracker
POSTGRES_DB=bubutracker

AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_AUDIENCE=https://api.bubutracker

CORS_ALLOWED_ORIGINS=*
MAX_REQUEST_BODY_BYTES=1048576

SHUTDOWN_TIMEOUT=15
REQUEST_TIMEOUT=10

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1800
DB_MAX_CONN_IDLE_TIME=300

{
  "description": "Body of a `source.crawled` message: the external ids one crawl of a source listed.",
  "properties": {
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "crawled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When JobIngestor fetched the data; orders stale redeliveries",
      "title": "Crawled At"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "external_ids": {
      "items": {
        "type": "string"
      },
      "title": "External Ids",
      "type": "array"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "source",
    "external_ids",
    "complete"
  ],
  "title": "SourceCrawled",
  "type": "object"
}

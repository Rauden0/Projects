# Used by docker-compose.prod.yml. Caddy gets and renews the Let's Encrypt certificate for
# DOMAIN (an A/AAAA record must point at this host, ports 80 and 443 open). DOMAIN=localhost
# uses Caddy's internal CA instead (deploy/smoke.sh).
{$DOMAIN} {
	# /chat streams server-sent events; leave them uncompressed so every event is flushed.
	@compressible not path /chat
	encode @compressible zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy api:8000
}

# Inside docker compose the hosts are the service names; for tools run on the host
# (pytest, alembic, eval/) use localhost instead.
DATABASE_URL=postgresql+asyncpg://jobmatcher:jobmatcher@postgres:5432/jobmatcher
AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# Local and free: Ollama (the `ollama` compose service, or Ollama installed on the host
# at http://host.docker.internal:11434/v1)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_S=180
# Send the extraction JSON schema as `response_format` (constrained decoding). Set to false
# for an OpenAI-compatible server that rejects the parameter.
LLM_STRUCTURED_OUTPUT=true
# For OpenAI-compatible reasoning models (e.g. openai/gpt-oss-120b on Groq): low | medium | high
LLM_REASONING_EFFORT=

# Optional: a stronger hosted model only for the chat agent (free tier at console.groq.com).
# CHAT_LLM_PROVIDER=openai_compat
# CHAT_LLM_BASE_URL=https://api.groq.com/openai/v1
# CHAT_LLM_MODEL=openai/gpt-oss-120b
# CHAT_LLM_API_KEY=gsk_...

# Or Anthropic, the cheapest setup: Haiku 5.5 with low effort, extraction through the
# Message Batches API (run `docker compose --profile batch up`) and a hard monthly cap.
# Also set a spend limit on the workspace in the Claude Console as a second guard.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# LLM_API_KEY=sk-ant-...
# LLM_EFFORT=low
# EXTRACTION_MODE=batch

# Budget and per-client chat limits. Every LLM call is written to `llm_usage`; the cost is
# known for Claude models only (other providers are recorded at $0, tokens still count).
LLM_MONTHLY_BUDGET_USD=40
LLM_EXTRACTION_BUDGET_SHARE=0.6
CHAT_REQUESTS_PER_MINUTE=6
CHAT_DAILY_TOKENS_PER_CLIENT=300000

EMBEDDING_MODEL=intfloat/multilingual-e5-small

# A local LLM handles one request at a time; more in flight only queue up and time out.
WORKER_PREFETCH=2

# text for humans, json for log shippers (one object per line, with request_id)
LOG_LEVEL=INFO
LOG_FORMAT=text

# OpenTelemetry traces over OTLP/HTTP: one `chat` span per /chat turn with a `chat {model}`
# span per LLM call and an `execute_tool {name}` span per tool call; extraction calls too.
# Empty = tracing off. `docker compose --profile phoenix up` runs Phoenix, then:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006   (http://localhost:6006 from the host)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=jobmatcher
# Put prompts, completions, tool arguments and tool results on spans. They contain CV and
# posting text, so keep it off outside local debugging.
OTEL_CAPTURE_CONTENT=false

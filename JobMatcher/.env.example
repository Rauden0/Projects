DATABASE_URL=postgresql+asyncpg://jobmatcher:jobmatcher@postgres:5432/jobmatcher
AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# Local and free: Ollama (the `ollama` compose service, or Ollama installed on the host
# at http://host.docker.internal:11434/v1)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# Optional: a stronger hosted model only for the chat agent (free tier at console.groq.com).
# CHAT_LLM_BASE_URL=https://api.groq.com/openai/v1
# CHAT_LLM_MODEL=llama-3.3-70b-versatile
# CHAT_LLM_API_KEY=gsk_...

# Or Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...

EMBEDDING_MODEL=intfloat/multilingual-e5-small

# A local LLM handles one request at a time; more in flight only queue up and time out.
WORKER_PREFETCH=2
